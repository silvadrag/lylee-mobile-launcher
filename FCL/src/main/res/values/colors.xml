<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="default_theme_color">#EC5990</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!-- Trước là #40F4F4F4 (trắng 25% trong suốt) — giả định nền app LUÔN tối
         nên chỉ cần phủ mờ nhẹ. Từ khi nền tùy chỉnh qua URL server (LyleeBackgroundSync)
         có thể sáng/nhiều màu, mức trong suốt đó không đủ tương phản cho chữ trắng
         (gần như biến mất). Đổi sang xám đậm gần đen, đủ đục để LUÔN đọc được bất kể
         nền sáng/tối, vẫn còn chút trong suốt (không phủ đặc hoàn toàn).
         Đây là giá trị CHẾ ĐỘ SÁNG (mặc định) — chữ/icon dùng use_theme_color trả về
         MÀU ĐEN ở chế độ sáng (color2, xem ThemeData.getColor2), nên panel ở đây phải
         SÁNG để tương phản; bản chế độ tối nằm ở values-night/colors.xml. Nếu chỉ để 1
         giá trị tối duy nhất, bật "chế độ sáng" trong Cài đặt sẽ không còn tác dụng gì
         lên các panel này, và chữ/icon đen sẽ biến mất trên nền tối. -->
    <color name="ui_bg_color">#E6F0F0F0</color>
    <color name="right_menu_color">#80F4F4F4</color>
    <color name="icon_background_color">#211B27</color>
    <!-- Đồng bộ ngôn ngữ thiết kế với launcher PC (docs/UI_DESIGN_GUIDELINES.md):
         nền chrome/khung tối, hồng #EC5990 chỉ dùng làm điểm nhấn (active/CTA),
         không phủ đặc lên vùng lớn. -->
    <color name="sidebar_bg">#141414</color>
    <color name="card_bg">#252525</color>
    <color name="primary_text">#0E0E0E</color>
    <!-- Màu của module FCLLibrary cũ (module đã gộp vào FCL) -->
    <color name="dialog_background">#F4F4F4</color>
</resources>