<?xml version="1.0" encoding="utf-8"?>
<!-- Trước chỉ có viền (stroke), KHÔNG có nền — trên nền app tối mặc định vẫn
     đọc được, nhưng nền tùy chỉnh sáng (LyleeBackgroundSync) thì chữ/viền gần
     như vô hình. Thêm nền đặc (solid) khớp màu ui_bg_color các panel khác. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/card_bg" />
            <stroke android:width="1dp" android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/ui_bg_color" />
            <stroke android:width="1dp" android:color="#3A3A3A" />
        </shape>
    </item>

</selector>