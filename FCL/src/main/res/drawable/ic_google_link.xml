<?xml version="1.0" encoding="utf-8"?>
<!-- Icon nút liên kết Google trên mỗi dòng tài khoản: logo Google (asset chính hãng,
     googleg_standard_color_18 từ play-services-base — KHÔNG dùng setColorFilter lên icon
     này ở code, sẽ làm mất màu logo) + badge góc dưới-phải báo trạng thái CHƯA liên kết.
     Bản đã liên kết xem ic_google_linked.xml (badge khác màu/icon). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="18dp"
        android:height="18dp"
        android:gravity="center"
        android:drawable="@drawable/googleg_standard_color_18" />
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="bottom|end"
        android:drawable="@drawable/ic_link_badge" />
</layer-list>
